{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KernelSim: Build application and tests",
      "type": "process",
      "command": "${workspaceFolder}\\build.bat",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "KernelSim: Run automated tests",
      "type": "process",
      "command": "${workspaceFolder}\\test.bat",
      "problemMatcher": ["$gcc"]
    }
  ]
}
